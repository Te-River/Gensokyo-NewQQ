# botgo specific
config.yml
*.db
*.db.lock
*.ini
*.bat

# Go specific
gensokyo.exe
gsk.exe
*.exe
*.upx
gensokyo

gensokyo-*

# 「gensokyo-*」会连带忽略 Rust workspace 的 crates/gensokyo-* 目录，源码必须例外入库
!crates/gensokyo-*/

# Ignore channel_temp
channel_temp/

# Ignore log
log/

# ignore dist（占位文件例外入库：clean clone 直接可构建 Go/Rust，见下方 un-ignore）
webui/dist/*

#ignore data
data/.vscode/

# local text artifacts and wordlists
*.txt
!readme.md
!docs/**/*.md
!docs/**/*.txt
!frontend/README.md

# sensitive word / runtime generated text files
handlers/sensitive_words_in.txt
handlers/sensitive_words_out.txt
**/sensitive_words_in.txt
**/sensitive_words_out.txt

# Build output
release/

# webui placeholder：入库占位，clean clone 无需先跑 build.ps1 即可 go build / cargo build
!webui/dist/placeholder.html
!webui/dist/index.html
!webui/dist/css/
webui/dist/css/*
!webui/dist/css/placeholder.css
!webui/dist/fonts/
webui/dist/fonts/*
!webui/dist/fonts/placeholder.txt
!webui/dist/icons/
webui/dist/icons/*
!webui/dist/icons/placeholder.txt
!webui/dist/js/
webui/dist/js/*
!webui/dist/js/placeholder.js

# AI editors / assistant tooling (local only)
.zcode/
.atomcode/
.aider*
.cursor/
.claude/
.codeium/
.continue/
.tabnine/
.github/copilot/
.windsurf/
